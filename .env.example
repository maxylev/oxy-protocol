# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The server auto-loads `.env` from the working directory; real env vars win.

# Standard OpenAI-compatible configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.6-luna

# OPENAI_BASE_URL may point at any OpenAI-compatible /v1 endpoint, e.g.:
#   https://api.openai.com/v1          (OpenAI)
#   https://openrouter.ai/api/v1       (OpenRouter)
#   https://llm.example.com/v1         (any compatible gateway)

# Optional tuning
# OXY_PARTICIPATION_MODEL=
# OXY_COMPACTION_MODEL=
# OXY_AGENT_NAME=Oxy
# OXY_ACCESS_TOKEN=
# OXY_ADMIN_TOKEN=
# OXY_DATA_DIR=~/.oxy-protocol
# PORT=8787
# HOST=0.0.0.0